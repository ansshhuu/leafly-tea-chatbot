# PostgreSQL connection used by the async SQLAlchemy engine (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://leafly_user:leafly_password@localhost:5432/leafly_db

# Used by Alembic (sync psycopg2 driver) for migrations
SYNC_DATABASE_URL=postgresql+psycopg2://leafly_user:leafly_password@localhost:5432/leafly_db

# App
APP_NAME=Leafly Tea Assistant
ENV=development

# Day 2 - AI chat backend

GEMINI_MODEL=gemini-3.1-flash-lite

# Soft request-per-minute / request-per-day caps enforced before calling
# Gemini, kept under the free-tier hard limits (15 RPM / 500 RPD)
GEMINI_RPM_LIMIT=12
GEMINI_RPD_LIMIT=450

# Email notifications (Brevo - https://brevo.com, free tier:
# 300 emails/day, no card required, no verified domain needed to send to
# any recipient). Sign up, grab an API key from Settings > SMTP & API >
# API Keys, then paste it below. If left blank, email_service.py logs a
# warning and skips sending - every other feature keeps working normally
# either way.
BREVO_API_KEY=

# When true, every AI-dependent code path (chat) returns a fixed mocked
# response instead of calling the real Gemini API - see
# ai_service._call_gemini. The automated test
# suite already mocks these functions directly per-test (see tests/conftest.py),
# so this is a belt-and-suspenders safety net for anything that ISN'T going
# through pytest (a manual smoke script, a test that forgot to monkeypatch),
# not something the test suite depends on. Leave false in real dev/prod use.
TEST_MODE=false

# Comma-separated list of origins allowed to call this API via CORS.
# Keep localhost entries for local frontend dev, plus the deployed
# Vercel frontend URL(s).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://leafly-tea-store-ten.vercel.app
